    {
      "parameters": {
        "jsCode": "const body = $('Receive Teams Activity').first().json.body;\nconst humanAdded = (body.membersAdded || []).filter(m => !m.id.startsWith('28:'));\nconst humanRemoved = (body.membersRemoved || []).filter(m => !m.id.startsWith('28:'));\nlet text;\nif (humanAdded.length > 0) {\n  const name = humanAdded[0].name || 'there';\n  text = \"Hello, \" + name + \"! I'm the JCB Teams Bot. Send me a message and I'll echo it back.\";\n} else if (humanRemoved.length > 0) {\n  const name = humanRemoved[0].name || 'someone';\n  text = \"Goodbye, \" + name + \"! See you later.\";\n} else { return []; }\nreturn [{ json: { _replyText: text } }];"
      },
