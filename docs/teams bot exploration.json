    {
      "parameters": {
        "jsCode": "const clientId = 'e6ee0253-8949-4eba-ba9f-f9d5da45fa1d';\n\nconst authHeader = $('Receive Teams Activity').first().json.headers.authorization || '';\nconst token = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : '';\nif (!token) return [];\n\nconst parts = token.split('.');\nif (parts.length !== 3) return [];\n\nlet header, payload;\ntry {\n  header = JSON.parse(Buffer.from(parts[0], 'base64url').toString('utf8'));\n  payload = JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8'));\n} catch (e) { return []; }\n\nconst now = Math.floor(Date.now() / 1000);\nif (payload.iss !== 'https://api.botframework.com') return [];\nif (payload.aud !== clientId) return [];\nif (payload.exp < now - 300) return [];\nif (payload.nbf > now + 300) return [];\n\nconst activityServiceUrl = $('Receive Teams Activity').first().json.body.serviceUrl;\nif (payload.serviceUrl && payload.serviceUrl !== activityServiceUrl) return [];\n\nconst jwks = $input.first().json;\nconst jwk = (jwks.keys || []).find(k => k.kid === header.kid);\nif (!jwk) return [];\n\ntry {\n  const subtle = require('crypto').webcrypto.subtle;\n  const publicKey = await subtle.importKey(\n    'jwk', jwk,\n    { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },\n    false, ['verify']\n  );\n  const signingInput = Buffer.from(parts[0] + '.' + parts[1]);\n  const signatureBytes = Buffer.from(parts[2], 'base64url');\n  const isValid = await subtle.verify(\n    'RSASSA-PKCS1-v1_5', publicKey, signatureBytes, signingInput\n  );\n  if (!isValid) return [];\n} catch (e) { return []; }\n\nreturn [{ json: { _validated: true } }];"
      },
