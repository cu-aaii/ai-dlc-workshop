__pycache__/
*.py[cod]
.venv/
venv/

.env
.env.*
!.env.example

# Terraform. State lives in S3 (see pipeline/pipeline.yml), never on disk here.
#
# .terraform.lock.hcl is deliberately NOT ignored -- it is the provider version lock, and
# committing it is what makes a laptop, PR checks and CodeBuild resolve identical provider
# versions. Ignoring it lets them drift silently.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Claude Code personal settings. Never commit: this repo is public, and these files hold
# machine-specific paths and per-user permission grants.
.claude/settings.local.json

# Local working notes and workshop handouts. Untracked but not ignored is how these get swept
# up by `git add -A`.
SCRATCHPAD.md
PARTICIPANT_BRIEF.md

# `aidlc-docs/` was ignored here. Removed deliberately: the pattern is unanchored, so it matched
# at every depth and silently ignored each track's AI-DLC artifacts, which are this workshop's
# primary deliverable. Track A's survive only because they were committed before the rule landed;
# already-tracked files are unaffected by .gitignore. Any track that had not yet committed was
# blocked without a signal, since the files never appear in `git status` and `git add -A` skips
# them. Local-only scratch belongs in `.git/info/exclude`, which is per-machine and needs no PR.

.DS_Store
.idea/
*.swp
