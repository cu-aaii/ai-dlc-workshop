# Copy to .env (gitignored -- never commit real values) and fill in.
# Sourced automatically by tools/dev. Only needed for the builder-mcp devtools chat console;
# the tool panel and direct invokes work without it.

ANTHROPIC_API_KEY=<Secret Key>
# Only set if you're not using api.anthropic.com directly (e.g. a sandbox/proxy endpoint).
ANTHROPIC_BASE_URL=https://api.ai.it.cornell.edu 
