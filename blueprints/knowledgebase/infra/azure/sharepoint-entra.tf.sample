// SAMPLE -- the verified shape, and still not deployable from this repo.
//
// This is no longer a sketch: it is the configuration behind the SharePoint data source that was
// observed ingesting and answering in this account (knowledge base sharepoint-kb / KANPIZQSGD).
// What it is not is pipeline-runnable, for two reasons that are properties of the work rather
// than of the repo:
//
//   1. No Terraform stage action names this directory. pipeline/validate_stacks.py cross-checks
//      every blueprints/*/infra/azure/ directory holding .tf files against the TF_WORKING_DIR
//      values in pipeline/pipeline.yml, in BOTH directions -- so renaming this to .tf fails PR
//      checks until the action exists. See blueprints/entra-probe/infra/azure/ for a module that
//      has one.
//   2. It reads .certs/ off local disk. The certificate is generated by hand (CloudFormation
//      cannot make a .p12, and a password in a template is a secret in a public repo), so an
//      unattended CodeBuild run has nothing to upload. Automating that means putting the
//      certificate somewhere the build can fetch it, which is the same problem one layer down.
//
// Read ../../docs/sharepoint-source.md first. It has the order of operations, the per-site Graph
// grant this file cannot express, and the standalone Entra verification that separates "Entra is
// misconfigured" from "Bedrock is misconfigured".
//
// WARNING: this repo is public and has NO secret scanning -- an enforced org security
// configuration disables it. Every value below is a reference, a path or a placeholder. The .p12,
// its password and the private key live in .certs/ (gitignored) and in AWS. Note also that the
// p12 password lands in Terraform STATE, so *.tfstate* must stay gitignored too.

terraform {
  required_version = ">= 1.9"

  required_providers {
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 3.0"
    }
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  // NOTE: no backend block, per this repo's convention -- every value arrives via
  // -backend-config so a module is environment-agnostic. Blocker #1 above is what would supply
  // them.
}

// ---------------------------------------------------------------------------------------------
// Variables
// ---------------------------------------------------------------------------------------------

variable "application" {
  description = "Matches the CloudFormation Application parameter"
  type        = string
  default     = "aidlc"
}

variable "environment" {
  description = "Branch name. Capped at 4 chars by the CloudFormation side; mirrored here so names line up."
  type        = string
  default     = "main"

  validation {
    condition     = can(regex("^[a-z0-9]{1,4}$", var.environment))
    error_message = "Environment must match [a-z0-9]{1,4}, same as every CloudFormation template here."
  }
}

variable "owner" {
  description = "cornell:owner"
  type        = string
  default     = "ai-sei"
}

variable "blueprint_version" {
  description = "cornell:blueprint-version. Keep in step with the CloudFormation template default."
  type        = string
  default     = "0.2.0"
}

variable "certs_dir" {
  description = <<-EOT
    Local directory holding the certificate material, generated by hand -- see
    ../../docs/sharepoint-source.md for the openssl sequence. Expected contents:

      certificate.cer   public certificate, uploaded to the Entra app registration
      certificate.p12   client certificate, uploaded to S3 for the Bedrock connector
      p12_password      the .p12 password, read into the Secrets Manager secret

    Gitignored. Never commit any of it, and never echo p12_password.
  EOT
  type        = string
  default     = ".certs"
}

variable "cert_end_date" {
  description = "Expiry registered with Entra. Must be at or before the certificate's own notAfter or Entra rejects it. This date is a hard deadline: when it passes, SharePoint ingestion fails and the shared pipeline goes red."
  type        = string
  default     = "2028-08-04T00:00:00Z"
}

variable "create_granter" {
  description = <<-EOT
    Whether to create the throwaway Sites.FullControl.All app used to issue per-site grants.

    Sites.Selected on its own grants NOTHING -- each site needs an explicit Graph grant, and
    issuing one requires a principal holding Sites.FullControl.All. So: flip this to true, apply,
    run the grant for the site, flip it back to false, apply again. The grant survives the
    granter's deletion (verified), so nothing is lost by removing it, and leaving a
    full-control-over-every-site app registration lying around is the thing to avoid.
  EOT
  type        = bool
  default     = false
}

locals {
  // Same convention as the CloudFormation stack names.
  name = "${var.application}-${var.environment}-knowledgebase"

  // All four cornell:* tags, on everything, same as the AWS side.
  tags = {
    "Application"               = var.application
    "Environment"               = var.environment
    "cornell:owner"             = var.owner
    "cornell:blueprint"         = "knowledgebase"
    "cornell:blueprint-version" = var.blueprint_version
    "cornell:deployment-id"     = local.name
  }

  cert_key = "certs/certificate.p12"
}

// ---------------------------------------------------------------------------------------------
// The two resource applications
// ---------------------------------------------------------------------------------------------
//
// The connector talks to Microsoft Graph AND to the SharePoint REST API. They are separate
// resource applications and each needs its own application-permission grant. Granting only Graph
// produces a token that reads site metadata and fails on content -- which surfaces as a scope
// error, not as a partial success.
//
// app_role_ids is why there are no GUIDs in this file. Copying app role ids from notes is how a
// Sites.Read.All + User.Read.All over-grant happens when Sites.Selected was meant: several are
// near-identical by eye, and a wrong one silently grants something else. Look them up.

data "azuread_client_config" "current" {}

data "azuread_service_principal" "msgraph" {
  client_id = "00000003-0000-0000-c000-000000000000"
}

data "azuread_service_principal" "sharepoint" {
  client_id = "00000003-0000-0ff1-ce00-000000000000"
}

// ---------------------------------------------------------------------------------------------
// The connector app registration
// ---------------------------------------------------------------------------------------------
//
// Sites.Selected, not Sites.Read.All: Sites.Read.All reads every site in the tenant, and the
// extra work for least privilege is one Graph call per site.
//
// There is deliberately NO azuread_application_password here. Certificate auth means the app
// should hold no client secret at all -- and a client secret is what the workshop's original app
// had, which is why that app cannot be used for ENTRA_ID_APP_ONLY.

resource "azuread_application" "connector" {
  display_name     = "${local.name}-sharepoint-connector"
  sign_in_audience = "AzureADMyOrg"
  owners           = [data.azuread_client_config.current.object_id]

  required_resource_access {
    resource_app_id = data.azuread_service_principal.msgraph.client_id

    resource_access {
      id   = data.azuread_service_principal.msgraph.app_role_ids["Sites.Selected"]
      type = "Role" // application permission, not delegated
    }
  }

  required_resource_access {
    resource_app_id = data.azuread_service_principal.sharepoint.client_id

    resource_access {
      id   = data.azuread_service_principal.sharepoint.app_role_ids["Sites.Selected"]
      type = "Role"
    }
  }
}

resource "azuread_service_principal" "connector" {
  client_id = azuread_application.connector.client_id
  owners    = [data.azuread_client_config.current.object_id]
}

// Admin consent for an application permission.
//
// This is azuread_app_role_assignment, NOT
// azuread_service_principal_delegated_permission_grant -- that resource is delegated-only and
// silently fails to consent a type = "Role" permission. Removing an over-grant is deleting the
// assignment from this config; the next apply destroys it.

resource "azuread_app_role_assignment" "graph" {
  app_role_id         = data.azuread_service_principal.msgraph.app_role_ids["Sites.Selected"]
  principal_object_id = azuread_service_principal.connector.object_id
  resource_object_id  = data.azuread_service_principal.msgraph.object_id
}

resource "azuread_app_role_assignment" "sharepoint" {
  app_role_id         = data.azuread_service_principal.sharepoint.app_role_ids["Sites.Selected"]
  principal_object_id = azuread_service_principal.connector.object_id
  resource_object_id  = data.azuread_service_principal.sharepoint.object_id
}

// The PUBLIC certificate goes on the app registration. The .p12 goes to S3 and its password to
// Secrets Manager -- three artifacts from one generation, and they must stay in step: rotating
// means replacing all three and re-syncing.

resource "azuread_application_certificate" "connector" {
  application_id = azuread_application.connector.id
  type           = "AsymmetricX509Cert"
  encoding       = "pem"
  value          = file("${path.module}/${var.certs_dir}/certificate.cer")
  end_date       = var.cert_end_date
}

// ---------------------------------------------------------------------------------------------
// The throwaway granter -- see var.create_granter
// ---------------------------------------------------------------------------------------------

resource "azuread_application" "granter" {
  count = var.create_granter ? 1 : 0

  display_name     = "${local.name}-sharepoint-granter"
  sign_in_audience = "AzureADMyOrg"
  owners           = [data.azuread_client_config.current.object_id]

  required_resource_access {
    resource_app_id = data.azuread_service_principal.msgraph.client_id

    resource_access {
      id   = data.azuread_service_principal.msgraph.app_role_ids["Sites.FullControl.All"]
      type = "Role"
    }
  }
}

resource "azuread_service_principal" "granter" {
  count = var.create_granter ? 1 : 0

  client_id = azuread_application.granter[0].client_id
  owners    = [data.azuread_client_config.current.object_id]
}

resource "azuread_app_role_assignment" "granter" {
  count = var.create_granter ? 1 : 0

  app_role_id         = data.azuread_service_principal.msgraph.app_role_ids["Sites.FullControl.All"]
  principal_object_id = azuread_service_principal.granter[0].object_id
  resource_object_id  = data.azuread_service_principal.msgraph.object_id
}

// A newly-consented granter works immediately -- no propagation wait was needed. Its own
// credential is deliberately absent from this file: create one interactively for the single
// grant call, or use a certificate the same way the connector does.

// ---------------------------------------------------------------------------------------------
// The AWS side of the handoff
// ---------------------------------------------------------------------------------------------
//
// Two artifacts, and they are the only things the CloudFormation template consumes: a bucket
// holding the .p12, and a secret holding the client id and the p12 password. The connector
// dereferences both itself, so neither ever passes through a template or a parameter value.

resource "aws_s3_bucket" "certs" {
  bucket = "${local.name}-sharepoint-certs"
  tags   = local.tags
}

resource "aws_s3_bucket_public_access_block" "certs" {
  bucket = aws_s3_bucket.certs.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "certs" {
  bucket = aws_s3_bucket.certs.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

// Under a PREFIX, not at the root. The connector probes for a sibling <key>.metadata.json, and
// the Bedrock role grants GetObject on certs/* precisely so that probe is not a denied call.

resource "aws_s3_object" "p12" {
  bucket = aws_s3_bucket.certs.id
  key    = local.cert_key
  source = "${path.module}/${var.certs_dir}/certificate.p12"
  etag   = filemd5("${path.module}/${var.certs_dir}/certificate.p12")
  tags   = local.tags
}

// Exactly two camelCase keys, for authType ENTRA_ID_APP_ONLY. Wrong key names fail with the same
// generic "secret has an invalid format or missing values" error as a wrong knowledge base type,
// so there is no diagnostic distance between the two mistakes.
//
// A separate secret from dev/workshop/entra/sharepoint on purpose: that one is the old
// client-secret credential, and writing into a hand-made secret from Terraform makes the
// hand-made one look managed when it isn't.

resource "aws_secretsmanager_secret" "connector" {
  name        = "bedrock/sharepoint-cert-connector"
  description = "Client id and .p12 password for the Bedrock SharePoint connector. authType ENTRA_ID_APP_ONLY."
  tags        = local.tags
}

resource "aws_secretsmanager_secret_version" "connector" {
  secret_id = aws_secretsmanager_secret.connector.id

  secret_string = jsonencode({
    clientId            = azuread_application.connector.client_id
    certificatePassword = chomp(file("${path.module}/${var.certs_dir}/p12_password"))
  })
}

// ---------------------------------------------------------------------------------------------
// Outputs -- these are the CloudFormation parameter values
// ---------------------------------------------------------------------------------------------
//
// None of them is a secret: an ARN, a bucket, a key, a tenant id and a client id are all
// references. Feed them to SharePointConnectorSecretArn, SharePointCertificateBucket,
// SharePointCertificateKey and SharePointTenantId in ../knowledgebase.yml AND in
// pipeline/pipeline.yml -- the pass-everything-explicitly rule means two files.

output "sharepoint_connector_secret_arn" {
  description = "SharePointConnectorSecretArn"
  value       = aws_secretsmanager_secret.connector.arn
}

output "sharepoint_certificate_bucket" {
  description = "SharePointCertificateBucket"
  value       = aws_s3_bucket.certs.id
}

output "sharepoint_certificate_key" {
  description = "SharePointCertificateKey"
  value       = local.cert_key
}

output "sharepoint_tenant_id" {
  description = "SharePointTenantId. Not a secret."
  value       = data.azuread_client_config.current.tenant_id
}

output "entra_client_id" {
  description = "Connector app client id. Needed for the per-site Graph grant, which this module cannot issue."
  value       = azuread_application.connector.client_id
}

// ---------------------------------------------------------------------------------------------
// What this module CANNOT do
// ---------------------------------------------------------------------------------------------
//
// 1. Issue the per-site grant. It is a Graph POST to /v1.0/sites/{siteId}/permissions with
//    roles: ["read"], made by the granter above. Sites.Selected grants nothing without it, and
//    the failure looks like a Bedrock problem.
// 2. Generate the certificate. By hand, per ../../docs/sharepoint-source.md.
// 3. Prove any of it works. Verify the Entra half standalone -- sign a client assertion, request
//    both audiences, assert the roles claim, list the site's drive children -- BEFORE enabling
//    EnableSharePointSource. Bedrock's error messages will not tell you which half is wrong.
